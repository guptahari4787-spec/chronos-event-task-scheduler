# Chronos Root Environment Reference
# Backend API configuration (server/.env)
HOST=127.0.0.1
PORT=2345
FRONTEND_ORIGIN=http://chronos.localhost:3456
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5433/chronos?schema=public
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
JWT_EXPIRES_IN=7d
REDIS_URL=redis://127.0.0.1:6379

# Frontend configuration (client/.env)
VITE_API_BASE_URL=http://api.chronos.localhost:2345/api
